# ==============================================================================
# RETAILMIND AI — NESTJS BACKEND DOCKERFILE
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY core-api/package*.json ./
RUN npm ci

COPY core-api ./
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    PORT=4000

COPY core-api/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

EXPOSE 4000

CMD ["node", "dist/main"]
